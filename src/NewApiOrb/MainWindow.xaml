<Window x:Class="NewApiOrb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New API Orb"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="展开 / 收起" Click="OnToggleClick" />
            <MenuItem Header="立即刷新" Click="OnRefreshClick" />
            <MenuItem Header="设置…" Click="OnSettingsClick" />
            <Separator />
            <MenuItem x:Name="MiTopmost" Header="窗口置顶" IsCheckable="True" Click="OnTopmostClick" />
            <MenuItem Header="贴边隐藏" IsCheckable="True" x:Name="MiDock" Click="OnDockToggleClick" />
            <Separator />
            <MenuItem Header="退出" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root" Margin="20">

        <!-- ==================== 收起态：科技球 ==================== -->
        <!-- Panel.ZIndex=1：球压在卡片之上，点击时才能看见它缩向球心"被吸进去" -->
        <Grid x:Name="BallHost"
              Panel.ZIndex="1"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Cursor="SizeAll"
              RenderTransformOrigin="0.5,0.5">

            <Grid.RenderTransform>
                <ScaleTransform x:Name="BallScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">

                            <!-- 外圈流光：正向慢转 -->
                            <DoubleAnimation Storyboard.TargetName="Arc1Rotate"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:16" />

                            <!-- 内圈流光：反向更慢 -->
                            <DoubleAnimation Storyboard.TargetName="Arc2Rotate"
                                             Storyboard.TargetProperty="Angle"
                                             From="360" To="0" Duration="0:0:26" />

                            <!-- 刻度环：极慢 -->
                            <DoubleAnimation Storyboard.TargetName="TickRotate"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:1:0" />

                            <!-- 弧光缓慢呼吸（GradientStop 不在 NameScope，改用 Opacity） -->
                            <DoubleAnimation Storyboard.TargetName="Arc1"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.5" To="1"
                                             Duration="0:0:5.5" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetName="Arc2"
                                             Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.3"
                                             Duration="0:0:7.5" AutoReverse="True" />

                            <!-- 内核呼吸 -->
                            <DoubleAnimation Storyboard.TargetName="Core"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.72" To="1"
                                             Duration="0:0:3.6" AutoReverse="True" />

                            <!-- 外光晕呼吸 -->
                            <DoubleAnimation Storyboard.TargetName="Halo"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.30" To="0.85"
                                             Duration="0:0:4.5" AutoReverse="True" />

                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <!-- 外光晕 -->
            <Ellipse x:Name="Halo" Margin="0" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#0000E5FF" Offset="0" />
                        <GradientStop Color="#2E00E5FF" Offset="0.72" />
                        <GradientStop Color="#0000E5FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 外圈流光弧 -->
            <Ellipse x:Name="Arc1" Margin="1" StrokeThickness="2"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0000E5FF" Offset="0" />
                        <GradientStop x:Name="Arc1StopA" Color="#E600E5FF" Offset="0.5" />
                        <GradientStop Color="#0000E5FF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="Arc1Rotate" Angle="0" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- 内圈流光弧（反向） -->
            <Ellipse x:Name="Arc2" Margin="7" StrokeThickness="1.2"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="#004C9AFF" Offset="0" />
                        <GradientStop x:Name="Arc2StopA" Color="#B34C9AFF" Offset="0.5" />
                        <GradientStop Color="#004C9AFF" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="Arc2Rotate" Angle="0" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- 刻度环 -->
            <Ellipse x:Name="TickRing" Margin="13" Stroke="#3D00E5FF"
                     StrokeThickness="1" StrokeDashArray="1 5"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="TickRotate" Angle="0" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- 内核 -->
            <Ellipse x:Name="Core" Margin="20">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF121C26" Offset="0" />
                        <GradientStop Color="#FF080D13" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#00E5FF" BlurRadius="16"
                                      ShadowDepth="0" Opacity="0.55" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- 数值 -->
            <StackPanel x:Name="BallContent"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="BallLabel" Text="今日 TOKEN"
                           TextAlignment="Center"
                           Foreground="#9900E5FF" />
                <TextBlock x:Name="BallValue" Text="—"
                           TextAlignment="Center" FontWeight="SemiBold"
                           FontFamily="Consolas, Microsoft YaHei UI"
                           Foreground="#FFFFFFFF">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00E5FF" BlurRadius="10"
                                          ShadowDepth="0" Opacity="0.75" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="BallDelta" Text="" Visibility="Collapsed"
                           TextAlignment="Center"
                           Foreground="#FF7C4DFF" />
            </StackPanel>
        </Grid>

        <!-- ==================== 展开态：数据卡 ==================== -->
        <Border x:Name="CardHost" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#F0080D13"
                BorderBrush="#6600E5FF"
                BorderThickness="1"
                CornerRadius="10"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.92" ScaleY="0.92" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#00E5FF" BlurRadius="22"
                                  ShadowDepth="0" Opacity="0.4" />
            </Border.Effect>

            <Grid>
                <!-- 顶部发光条 -->
                <Rectangle Height="2" VerticalAlignment="Top" RadiusX="1" RadiusY="1">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0000E5FF" Offset="0" />
                            <GradientStop Color="#FF00E5FF" Offset="0.5" />
                            <GradientStop Color="#0000E5FF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Margin="16,16,16,14">

                    <Grid>
                        <TextBlock Text="今日用量" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FF00E5FF"
                                   FontFamily="Microsoft YaHei UI, Segoe UI" />
                        <TextBlock x:Name="CardUpdated" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11" Foreground="#7300E5FF"
                                   FontFamily="Consolas, Microsoft YaHei UI" />
                    </Grid>

                    <Rectangle Height="1" Fill="#2600E5FF" Margin="0,10,0,0" />

                    <ItemsControl x:Name="FieldList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="#99FFFFFF" FontSize="12"
                                               FontFamily="Microsoft YaHei UI, Segoe UI" />
                                    <TextBlock Text="{Binding Value}"
                                               HorizontalAlignment="Right"
                                               FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Consolas, Microsoft YaHei UI"
                                               Foreground="{Binding ValueBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="ChartHost" Margin="0,14,0,0" Visibility="Collapsed">
                        <Rectangle Height="1" Fill="#2600E5FF" Margin="0,0,0,10" />
                        <TextBlock Text="今日按小时" FontSize="11" Foreground="#7300E5FF"
                                   FontFamily="Microsoft YaHei UI, Segoe UI" />
                        <ItemsControl x:Name="HourChart" Height="54" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Height="{Binding BarHeight}" Width="7"
                                               Fill="{Binding BarBrush}"
                                               RadiusX="2" RadiusY="2"
                                               VerticalAlignment="Bottom"
                                               HorizontalAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 按令牌分布 -->
                    <StackPanel x:Name="TokenHost" Margin="0,14,0,0" Visibility="Collapsed">
                        <Rectangle Height="1" Fill="#2600E5FF" Margin="0,0,0,10" />
                        <TextBlock Text="今日按令牌" FontSize="11" Foreground="#7300E5FF"
                                   FontFamily="Microsoft YaHei UI, Segoe UI" />
                        <ItemsControl x:Name="TokenList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="#B3FFFFFF" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="Microsoft YaHei UI, Segoe UI" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   Foreground="#FF00E5FF" FontSize="12"
                                                   FontWeight="SemiBold" Margin="10,0,0,0"
                                                   FontFamily="Consolas, Microsoft YaHei UI" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
